Bootstrap: docker
From: python:3.12-slim
# scvi-tools==1.5.0.post1 (pinned below, fixes the 1.4.2 rich.pretty bug)
# requires Python >=3.12 -- python:3.11-slim silently downgraded to 1.4.2.

%labels
    Version         1.0.0
    Description     dpnvisium — Cell2Location Visium spatial deconvolution pipeline (ish_dpn project)
    Maintainer      mwilde49

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        pkg-config \
        libhdf5-dev \
        libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip

    # PINNED, not left to float: a first build with an unpinned
    # `pip install cell2location[tutorials]` independently resolved
    # torch==2.13.0+cu130 + scvi-tools==1.4.2 (different from the versions
    # actually validated on the host dev venv across 4 local test tiers) and
    # broke two ways in production on Juno's H200 partition: (1) scvi-tools
    # 1.4.2's view_anndata_setup() hits `AttributeError: module 'rich' has no
    # attribute 'pretty'` -- fixed in scvi-tools 1.5.0.post1, which is what
    # host-venv testing actually used; (2) torch 2.13.0+cu130 reported
    # `cuda available: False` on the H200 node despite --nv and a real GPU
    # allocation -- root cause unconfirmed, but 2.11.0+cu128 is the version
    # that was actually GPU-verified (Tiers 0-3, real training runs) on this
    # project's dev hardware, so pin to that rather than re-guess. Install
    # torch explicitly first so cell2location's own resolution can't override
    # it, then pin the packages that broke.
    pip install --no-cache-dir torch==2.11.0+cu128 --index-url https://download.pytorch.org/whl/cu128

    pip install --no-cache-dir \
        cell2location[tutorials]==0.1.5 \
        scvi-tools==1.5.0.post1 \
        anndata==0.13.3.post0 \
        scanpy==1.12.4 \
        rich==15.0.0 \
        pyyaml

    pip cache purge

%environment
    export PYTHONNOUSERSITE=1
    export MPLBACKEND=Agg
    # Suppress TensorFlow / PyTorch noise unrelated to training
    export TF_CPP_MIN_LOG_LEVEL=3

%runscript
    exec python "$@"
